# InfraTrace backend configuration
# Copy to .env and fill in. NEVER commit .env - it is in .gitignore.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=infratrace

# Use a dedicated least-privilege account, not root.
# The API is read-only, so it needs only SELECT and EXECUTE:
#
#   CREATE USER 'infratrace_api'@'localhost' IDENTIFIED BY 'choose-a-strong-password';
#   GRANT SELECT  ON infratrace.* TO 'infratrace_api'@'localhost';
#   GRANT EXECUTE ON infratrace.* TO 'infratrace_api'@'localhost';
#   FLUSH PRIVILEGES;
#
# EXECUTE is required because the API calls stored procedures
# (sp_get_blast_radius, sp_component_impact_report, ...) and stored
# functions (fn_risk_score, ...). No INSERT/UPDATE/DELETE is needed.
DB_USER=infratrace_api
DB_PASSWORD=

# Comma-separated list of browser origins allowed to call this API.
# Keep it explicit - do not use "*".
CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
